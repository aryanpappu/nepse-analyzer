# Copy to .env.production; do not commit the completed file.
APP_DOMAIN=analyzer.example.com
ACME_EMAIL=operator@example.com
RELEASE_TAG=local
# Generate once: php backend/artisan key:generate --show
APP_KEY=
DB_DATABASE=nepse_analyzer
DB_USERNAME=nepse
# Use separate random credentials. Do not use the development examples.
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_PASSWORD=

APP_NAME="NEPSE Analyzer"
APP_TIMEZONE=Asia/Kathmandu
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="NEPSE Analyzer"

# Optional temporary first-admin bootstrap, removed after seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=

AI_DRIVER=gemini
GEMINI_API_KEY=
GEMINI_DAILY_CALL_LIMIT=100
ANTHROPIC_API_KEY=
ANTHROPIC_DAILY_CALL_LIMIT=100
NEPSE_ANALYSIS_MAX_PRICE_AGE_DAYS=7
NEPSE_ANALYSIS_MAX_NAV_AGE_DAYS=45

# Set to the real service operator and published policy URLs before launch.
PUBLIC_OPERATOR_NAME=
PUBLIC_CONTACT_EMAIL=
PUBLIC_PRIVACY_URL=
PUBLIC_TERMS_URL=
MARKET_DATA_PERMISSION_CONFIRMED=false

# Worker/scheduler monitoring grace periods in seconds.
SCHEDULER_HEARTBEAT_MAX_AGE=180
PIPELINE_HEARTBEAT_MAX_AGE=4500
AI_HEARTBEAT_MAX_AGE=600
