# syntax=docker/dockerfile:1
FROM php:8.4-fpm-alpine AS php-base
RUN apk add --no-cache icu-libs oniguruma libzip \
    && apk add --no-cache --virtual .build-deps $PHPIZE_DEPS linux-headers icu-dev oniguruma-dev libzip-dev \
    && docker-php-ext-install -j"$(nproc)" pdo_mysql bcmath intl zip opcache mbstring pcntl \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del .build-deps
WORKDIR /var/www

FROM php-base AS dependencies
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY backend/composer.json backend/composer.lock ./
RUN composer install --no-dev --no-interaction --no-scripts --no-autoloader --prefer-dist
COPY backend/ .
RUN composer dump-autoload --no-dev --optimize --classmap-authoritative

FROM php-base AS production
COPY --from=dependencies --chown=www-data:www-data /var/www /var/www
COPY LICENSE /var/LICENSE
COPY --chmod=755 backend/docker/production-entrypoint.sh /usr/local/bin/app-entrypoint
RUN mkdir -p storage/logs storage/app/private storage/framework/cache/data storage/framework/sessions storage/framework/views bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && printf '%s\n' 'opcache.enable=1' 'opcache.validate_timestamps=0' 'opcache.memory_consumption=128' 'memory_limit=512M' 'expose_php=Off' > /usr/local/etc/php/conf.d/zz-production.ini
USER www-data
EXPOSE 9000
ENTRYPOINT ["app-entrypoint"]
CMD ["php-fpm", "-F"]
