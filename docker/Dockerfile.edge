# syntax=docker/dockerfile:1
FROM node:22-alpine AS frontend-build
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM caddy:2-alpine
COPY --from=frontend-build /build/dist /srv/frontend
# Caddy and FPM agree on the script path; only Laravel's public directory is copied.
COPY backend/public /var/www/public
COPY docker/Caddyfile.production /etc/caddy/Caddyfile
